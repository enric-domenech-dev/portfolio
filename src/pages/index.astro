---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import cvData from '../data/cv.json';
---

<Layout title="Portfolio - Enric Domènech" description="Portfolio profesional de Enric Domènech - Full-Stack & Mobile Developer">
  <Header personal={cvData.personal} />

  <nav class="bg-white sticky top-0 shadow-sm z-50">
    <div class="max-w-4xl mx-auto px-4 py-4 flex gap-6 justify-center">
      <a href="#experience" class="hover:text-indigo-600 transition">Experiencia</a>
      <a href="#education" class="hover:text-indigo-600 transition">Educación</a>
      <a href="#skills" class="hover:text-indigo-600 transition">Skills</a>
      <a href="/cv" class="bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-opacity-90 transition">📄 CV</a>
    </div>
  </nav>

  <main>
    <div id="experience">
      <Experience items={cvData.experience} />
    </div>
    <div id="education">
      <Education items={cvData.education} />
    </div>
    <div id="skills">
      <Skills skills={cvData.skills} />
    </div>
  </main>

  <footer class="bg-gray-900 text-white py-8 px-4 mt-12">
    <div class="max-w-4xl mx-auto text-center">
      <p>&copy; 2024 Enric Domènech. Todos los derechos reservados.</p>
      <p class="text-gray-400 mt-2">Diseñado con ❤️ usando Astro + Tailwind CSS</p>
    </div>
  </footer>
</Layout>
