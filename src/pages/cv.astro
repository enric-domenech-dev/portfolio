---
import Layout from '../layouts/Layout.astro';
import cvData from '../data/cv.json';
---

<Layout title="CV - Enric Domènech">
  <div class="max-w-4xl mx-auto p-4">
    <div class="flex gap-4 mb-6 print:hidden sticky top-0 bg-white z-10 py-4">
      <button 
        id="downloadBtn" 
        class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-opacity-90 transition flex items-center gap-2"
      >
        ⬇️ Descargar PDF
      </button>
      <button 
        id="printBtn" 
        class="bg-cyan-500 text-white px-6 py-2 rounded-lg hover:bg-opacity-90 transition flex items-center gap-2"
      >
        🖨️ Imprimir
      </button>
    </div>

    <div id="cvContent" class="bg-white p-8 print:p-0">
      <!-- Header -->
      <div class="mb-8 pb-8 border-b-2">
        <h1 class="text-4xl font-bold text-indigo-600 mb-2">{cvData.personal.name}</h1>
        <p class="text-xl text-gray-600 mb-4">{cvData.personal.title}</p>
        <p class="text-gray-700 mb-4">{cvData.personal.bio}</p>
        
        <div class="grid grid-cols-2 gap-4 text-sm">
          <div>📧 {cvData.personal.email}</div>
          <div>📱 {cvData.personal.phone}</div>
          <div>📍 {cvData.personal.location}</div>
          <div>🎂 {cvData.personal.birthDate}</div>
        </div>
      </div>

      <!-- Education -->
      <section class="mb-8">
        <h2 class="text-2xl font-bold text-indigo-600 mb-4">Formación Académica</h2>
        <div class="space-y-4">
          {cvData.education.map((edu) => (
            <div class="border-l-4 border-indigo-600 pl-4">
              <h3 class="font-bold">{edu.degree}</h3>
              <p class="text-gray-600">{edu.institution}</p>
              <p class="text-sm text-gray-500">{edu.year}{edu.status && ` - ${edu.status}`}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Experience -->
      <section class="mb-8">
        <h2 class="text-2xl font-bold text-indigo-600 mb-4">Experiencia Profesional</h2>
        <div class="space-y-4">
          {cvData.experience.map((exp) => (
            <div class="border-l-4 border-cyan-500 pl-4">
              <div class="flex justify-between items-start">
                <div>
                  <h3 class="font-bold">{exp.position}</h3>
                  <p class="text-gray-600">{exp.company}</p>
                </div>
                <span class="text-sm text-gray-500">{exp.duration}</span>
              </div>
              <p class="text-sm text-gray-700 mt-2">{exp.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Skills -->
      <section class="mb-8">
        <h2 class="text-2xl font-bold text-indigo-600 mb-4">Competencias</h2>
        <div class="grid grid-cols-2 gap-6">
          <div>
            <h3 class="font-bold mb-2">Desarrollo Mobile</h3>
            <p class="text-sm text-gray-700">{cvData.skills.mobile.join(', ')}</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Backend</h3>
            <p class="text-sm text-gray-700">{cvData.skills.backend.join(', ')}</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Frontend</h3>
            <p class="text-sm text-gray-700">{cvData.skills.frontend.join(', ')}</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Bases de Datos</h3>
            <p class="text-sm text-gray-700">{cvData.skills.databases.join(', ')}</p>
          </div>
        </div>
      </section>

      <!-- Languages -->
      <section>
        <h2 class="text-2xl font-bold text-indigo-600 mb-4">Idiomas</h2>
        <div class="grid grid-cols-3 gap-4">
          {cvData.languages.map((lang) => (
            <div class="text-sm">
              <p class="font-bold">{lang.language}</p>
              <p class="text-gray-600">{lang.level}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <script>
    document.getElementById('downloadBtn')?.addEventListener('click', function() {
      const element = document.getElementById('cvContent');
      const opt = {
        margin: 10,
        filename: 'Enric_Domenech_CV.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2 },
        jsPDF: { orientation: 'portrait', unit: 'mm', format: 'a4' }
      };
      html2pdf().set(opt).from(element).save();
    });

    document.getElementById('printBtn')?.addEventListener('click', function() {
      window.print();
    });
  </script>

  <style>
    @media print {
      body {
        background: white;
      }
      #cvContent {
        box-shadow: none;
        margin: 0;
      }
    }
  </style>
</Layout>
