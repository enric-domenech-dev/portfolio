---
import Layout from '../layouts/Layout.astro';
import cvData from '../data/cv.json';
---

<Layout title="CV - Enric Domènech">
  <div class="max-w-5xl mx-auto p-4 md:p-6">
    <div class="glass-card flex flex-wrap gap-3 mb-6 print:hidden sticky top-4 z-10 p-4">
      <button 
        id="downloadBtn" 
        class="inline-flex items-center gap-2 bg-primary-500 text-white px-6 py-2.5 rounded-full hover:bg-primary-600 hover:-translate-y-0.5 transition duration-300 shadow-glow"
      >
        <span>⬇️</span> Descargar PDF
      </button>
      <button 
        id="printBtn" 
        class="inline-flex items-center gap-2 bg-secondary-500 text-white px-6 py-2.5 rounded-full hover:bg-secondary-600 hover:-translate-y-0.5 transition duration-300 shadow-soft"
      >
        <span>🖨️</span> Imprimir
      </button>
    </div>

    <div id="cvContent" class="neo-panel p-6 md:p-10 print:bg-white print:shadow-none print:p-0">
      <!-- Header -->
      <div class="mb-8 pb-8 border-b border-slate-300/60">
        <p class="uppercase tracking-[0.24em] text-xs text-primary-500 mb-2">Curriculum Vitae</p>
        <h1 class="text-4xl font-extrabold text-primary-600 mb-2">{cvData.personal.name}</h1>
        <p class="text-xl text-slate-600 mb-4">{cvData.personal.title}</p>
        <p class="text-slate-700 mb-4 leading-relaxed">{cvData.personal.bio}</p>
        
        <div class="grid sm:grid-cols-2 gap-3 text-sm">
          <div class="glass-card !rounded-xl !shadow-none p-3">📧 {cvData.personal.email}</div>
          <div class="glass-card !rounded-xl !shadow-none p-3">📱 {cvData.personal.phone}</div>
          <div class="glass-card !rounded-xl !shadow-none p-3">📍 {cvData.personal.location}</div>
          <div class="glass-card !rounded-xl !shadow-none p-3">🎂 {cvData.personal.birthDate}</div>
        </div>
      </div>

      <!-- Education -->
      <section class="mb-8">
        <h2 class="text-2xl font-bold text-primary-600 mb-4">Formación Académica</h2>
        <div class="space-y-4">
          {cvData.education.map((edu) => (
            <div class="glass-card !rounded-2xl p-4">
              <h3 class="font-bold">{edu.degree}</h3>
              <p class="text-slate-600">{edu.institution}</p>
              <p class="text-sm text-slate-500 mt-1">{edu.year}{edu.status && ` · ${edu.status}`}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Experience -->
      <section class="mb-8">
        <h2 class="text-2xl font-bold text-primary-600 mb-4">Experiencia Profesional</h2>
        <div class="space-y-4">
          {cvData.experience.map((exp) => (
            <div class="glass-card !rounded-2xl p-4">
              <div class="flex justify-between items-start">
                <div>
                  <h3 class="font-bold">{exp.position}</h3>
                  <p class="text-slate-600">{exp.company}</p>
                </div>
                <span class="text-sm rounded-full bg-primary-100 text-primary-700 px-3 py-1">{exp.duration}</span>
              </div>
              <p class="text-sm text-slate-700 mt-2">{exp.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Skills -->
      <section class="mb-8">
        <h2 class="text-2xl font-bold text-primary-600 mb-4">Competencias</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <h3 class="font-bold mb-2">Desarrollo Mobile</h3>
            <p class="text-sm text-slate-700">{cvData.skills.mobile.join(', ')}</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Backend</h3>
            <p class="text-sm text-slate-700">{cvData.skills.backend.join(', ')}</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Frontend</h3>
            <p class="text-sm text-slate-700">{cvData.skills.frontend.join(', ')}</p>
          </div>
          <div>
            <h3 class="font-bold mb-2">Bases de Datos</h3>
            <p class="text-sm text-slate-700">{cvData.skills.databases.join(', ')}</p>
          </div>
        </div>
      </section>

      <!-- Languages -->
      <section>
        <h2 class="text-2xl font-bold text-primary-600 mb-4">Idiomas</h2>
        <div class="grid sm:grid-cols-3 gap-3">
          {cvData.languages.map((lang) => (
            <div class="glass-card !rounded-xl !shadow-none p-3 text-sm">
              <p class="font-bold">{lang.language}</p>
              <p class="text-slate-600">{lang.level}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <script>
    document.getElementById('downloadBtn')?.addEventListener('click', function() {
      const element = document.getElementById('cvContent');
      const opt = {
        margin: 10,
        filename: 'Enric_Domenech_CV.pdf',
        image: { type: 'jpeg', quality: 0.98 },
        html2canvas: { scale: 2 },
        jsPDF: { orientation: 'portrait', unit: 'mm', format: 'a4' }
      };
      html2pdf().set(opt).from(element).save();
    });

    document.getElementById('printBtn')?.addEventListener('click', function() {
      window.print();
    });
  </script>

  <style>
    @media print {
      body {
        background: white;
      }
      #cvContent {
        box-shadow: none;
        margin: 0;
        border-radius: 0;
      }
    }
  </style>
</Layout>
