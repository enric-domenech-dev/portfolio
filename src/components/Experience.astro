---
interface Props {
  items: any[];
}

const { items } = Astro.props;
---

<section class="py-12 px-4">
  <div class="max-w-5xl mx-auto">
    <h2 class="section-title">Experiencia Profesional</h2>

    <div class="relative pl-5 md:pl-8 space-y-6 before:absolute before:left-1 before:top-2 before:bottom-2 before:w-0.5 before:bg-gradient-to-b before:from-primary-500 before:to-secondary-400">
      {items.map((exp, index) => (
        <article class="relative glass-card p-6 md:p-7 transition duration-400 hover:-translate-y-1 hover:shadow-glow animate-fade-up" style={`animation-delay:${index * 100}ms`}>
          <span class="absolute -left-6 md:-left-9 top-9 h-4 w-4 rounded-full bg-primary-500 ring-4 ring-primary-200/60"></span>
          <div class="flex flex-wrap justify-between items-start gap-3 mb-3">
            <div>
              <p class="text-xs uppercase tracking-[0.2em] text-primary-500 mb-2">💼 Carrera</p>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-slate-100">{exp.position}</h3>
              <p class="text-base md:text-lg text-slate-600 dark:text-slate-300">{exp.company}</p>
            </div>
            <span class="neo-panel text-sm font-semibold text-primary-700 px-4 py-1.5">{exp.duration}</span>
          </div>
          <p class="text-slate-700 dark:text-slate-200 leading-relaxed">{exp.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
