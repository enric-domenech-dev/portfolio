---
interface Props {
  items: any[];
}

const { items } = Astro.props;
---

<section class="py-12 px-4">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold mb-8 text-indigo-600">Experiencia Profesional</h2>
    
    <div class="space-y-6">
      {items.map((exp) => (
        <div class="border-l-4 border-indigo-600 pl-6 pb-6">
          <div class="flex justify-between items-start mb-2">
            <div>
              <h3 class="text-xl font-bold">{exp.position}</h3>
              <p class="text-lg text-gray-600">{exp.company}</p>
            </div>
            <span class="text-sm text-gray-500">{exp.duration}</span>
          </div>
          <p class="text-gray-700">{exp.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
