---
interface Props {
  skills: any;
}

const { skills } = Astro.props;

const skillsCategories = [
  { title: '📱 Mobile & Frontend', skills: skills.mobile },
  { title: '☕ Backend & Database', skills: skills.backend },
  { title: '🎮 Game Development', skills: skills.gamedev },
  { title: '🛠️ Dev Tools', skills: skills.tools },
];
---

<section class="py-12 px-4 bg-gray-100">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl font-bold mb-8 text-indigo-600">Competencias</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {skillsCategories.map((category) => (
        <div class="bg-white p-6 rounded-lg shadow-sm">
          <h3 class="text-lg font-bold mb-4">{category.title}</h3>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <span class="bg-indigo-600 text-white px-3 py-1 rounded-full text-sm">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
