---
interface Props {
  personal: any;
}

const { personal } = Astro.props;
---

<nav class="sticky top-0 z-50 px-4 py-4">
  <div class="glass-card max-w-5xl mx-auto px-5 md:px-8 py-3 md:py-4">
    <div class="flex items-center justify-between gap-4">
      <a href="#top" class="text-sm md:text-base font-semibold tracking-wide text-slate-800 dark:text-slate-100">
        {personal.name}
      </a>

      <button
        id="menuToggle"
        class="md:hidden text-slate-700 dark:text-slate-100 text-2xl leading-none"
        aria-expanded="false"
        aria-controls="mobileMenu"
        aria-label="Abrir menú de navegación"
      >
        ☰
      </button>

      <div class="hidden md:flex items-center gap-6 text-sm font-medium">
        <a href="#experience" class="animated-underline text-slate-700 hover:text-primary-600 dark:text-slate-200">Experiencia</a>
        <a href="#education" class="animated-underline text-slate-700 hover:text-primary-600 dark:text-slate-200">Educación</a>
        <a href="#skills" class="animated-underline text-slate-700 hover:text-primary-600 dark:text-slate-200">Skills</a>
        <a href="/cv" class="px-4 py-2 rounded-full bg-primary-500 text-white shadow-glow hover:bg-primary-600 transition duration-300">CV</a>
      </div>
    </div>

    <div id="mobileMenu" class="hidden mt-4 pt-4 border-t border-white/40 md:hidden">
      <div class="flex flex-col gap-4 text-sm font-medium">
        <a href="#experience" class="text-slate-700 hover:text-primary-600 dark:text-slate-200">Experiencia</a>
        <a href="#education" class="text-slate-700 hover:text-primary-600 dark:text-slate-200">Educación</a>
        <a href="#skills" class="text-slate-700 hover:text-primary-600 dark:text-slate-200">Skills</a>
        <a href="/cv" class="w-fit px-4 py-2 rounded-full bg-primary-500 text-white shadow-glow">Ver CV</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');

  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
  });
</script>
