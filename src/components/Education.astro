---
interface Props {
  items: any[];
}

const { items } = Astro.props;
---

<section class="py-12 px-4">
  <div class="max-w-5xl mx-auto">
    <h2 class="section-title">Formación Académica</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
      {items.map((edu, index) => (
        <article class="neo-panel p-6 border border-white/70 transition duration-400 hover:-translate-y-1 hover:shadow-glow animate-fade-up" style={`animation-delay:${index * 120}ms`}>
          <div class="h-1.5 w-full rounded-full bg-gradient-to-r from-primary-500 to-secondary-400 mb-5"></div>
          <p class="text-xs uppercase tracking-[0.2em] text-primary-500 mb-2">🎓 Educación</p>
          <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 mb-2">{edu.degree}</h3>
          <p class="text-slate-600 dark:text-slate-300 mb-4">{edu.institution}</p>
          <div class="flex justify-between items-center mt-auto">
            <span class="text-sm text-slate-500 dark:text-slate-400">{edu.year}</span>
            {edu.status && (
              <span class="rounded-full bg-secondary-300/30 text-secondary-600 text-xs font-semibold px-3 py-1">
                {edu.status}
              </span>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
