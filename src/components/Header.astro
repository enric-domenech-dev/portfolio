---
interface Props {
  personal: any;
}

const { personal } = Astro.props;
---

<header class="bg-gradient-to-r from-indigo-600 to-cyan-500 text-white py-16 px-4">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-bold mb-2">{personal.name}</h1>
    <p class="text-xl md:text-2xl text-gray-100 mb-4">{personal.title}</p>
    <p class="text-gray-200 mb-6 max-w-2xl">{personal.bio}</p>
    
    <div class="flex flex-wrap gap-4 text-sm">
      <a href={`mailto:${personal.email}`} class="hover:underline">
        📧 {personal.email}
      </a>
      <a href={`tel:${personal.phone}`} class="hover:underline">
        📱 {personal.phone}
      </a>
      <span>📍 {personal.location}</span>
    </div>

    <div class="flex gap-4 mt-6">
      {personal.links.linkedin && (
        <a href={personal.links.linkedin} target="_blank" rel="noopener noreferrer" class="hover:underline">
          💼 LinkedIn
        </a>
      )}
      {personal.links.github && (
        <a href={personal.links.github} target="_blank" rel="noopener noreferrer" class="hover:underline">
          🐙 GitHub
        </a>
      )}
    </div>
  </div>
</header>
