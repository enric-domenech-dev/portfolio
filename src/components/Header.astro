---
interface Props {
  personal: any;
}

const { personal } = Astro.props;
---

<header class="text-white px-4 py-6 md:py-8">
  <div class="relative overflow-hidden rounded-[2rem] max-w-5xl mx-auto bg-hero-gradient bg-[length:200%_200%] animate-gradient-shift shadow-glow px-6 md:px-10 py-16 md:py-20">
    <div class="absolute inset-0 bg-slate-900/15"></div>
    <div class="relative animate-fade-up">
      <p class="uppercase tracking-[0.24em] text-xs md:text-sm text-cyan-100 mb-4">Portfolio Profesional</p>
      <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-4">{personal.name}</h1>
      <p class="text-xl md:text-2xl font-medium text-indigo-100 mb-5">{personal.title}</p>
      <p class="text-slate-100/95 max-w-3xl mb-8 text-base md:text-lg">{personal.bio}</p>

      <div class="flex flex-wrap gap-3 text-sm md:text-base text-slate-100 mb-8">
        <a href={`mailto:${personal.email}`} class="glass-card !rounded-full !shadow-none px-4 py-2 hover:-translate-y-0.5 transition duration-300">
          📧 {personal.email}
        </a>
        <a href={`tel:${personal.phone}`} class="glass-card !rounded-full !shadow-none px-4 py-2 hover:-translate-y-0.5 transition duration-300">
          📱 {personal.phone}
        </a>
        <span class="glass-card !rounded-full !shadow-none px-4 py-2">📍 {personal.location}</span>
      </div>

      <div class="flex flex-wrap gap-4">
        <a href="#experience" class="inline-flex items-center gap-2 rounded-full bg-white text-primary-600 font-semibold px-6 py-3 hover:scale-[1.02] transition duration-300">
          Explorar experiencia →
        </a>
        <a href="/cv" class="inline-flex items-center gap-2 rounded-full border border-white/60 bg-white/10 font-semibold px-6 py-3 hover:bg-white/20 transition duration-300">
          Ver CV completo
        </a>
        {personal.links.linkedin && (
          <a href={personal.links.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/60 bg-white/10 font-semibold px-6 py-3 hover:bg-white/20 transition duration-300">
            LinkedIn
          </a>
        )}
        {personal.links.github && (
          <a href={personal.links.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full border border-white/60 bg-white/10 font-semibold px-6 py-3 hover:bg-white/20 transition duration-300">
            GitHub
          </a>
        )}
      </div>
    </div>
  </div>
</header>
