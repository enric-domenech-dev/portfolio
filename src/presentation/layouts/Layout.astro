---
import '../../styles/global.css';
import { SITE_DEFAULTS } from '@/core/shared/constants/ui';

interface Props {
  title: string;
  description?: string;
}

const { title, description = SITE_DEFAULTS.description } = Astro.props;
---

<!doctype html>
<html lang={SITE_DEFAULTS.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
