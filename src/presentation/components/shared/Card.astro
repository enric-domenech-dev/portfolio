---
import { classNames } from '@/core/shared/utils/classNames';

interface Props {
  variant?: 'glass' | 'neo';
  hover?: boolean;
  class?: string;
  style?: string;
}

const { variant = 'glass', hover = false, class: className, style } = Astro.props;

const baseClasses = variant === 'glass' ? 'glass-card' : 'neo-panel';
const hoverClasses = hover
  ? 'transition duration-300 ease-out hover:-translate-y-1 hover:shadow-lift hover:ring-1 hover:ring-primary-300/50 dark:hover:ring-primary-400/25'
  : '';
---

<article class={classNames(baseClasses, hoverClasses, className)} style={style}>
  <slot />
</article>
