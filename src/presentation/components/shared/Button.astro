---
import { classNames } from '@/core/shared/utils/classNames';

interface Props {
  href: string;
  variant?: 'solid' | 'outline';
  target?: string;
  rel?: string;
  class?: string;
}

const { href, variant = 'solid', target, rel, class: className } = Astro.props;

const variantClasses: Record<NonNullable<Props['variant']>, string> = {
  solid: 'bg-white text-primary-600 hover:scale-[1.02]',
  outline: 'border border-white/60 bg-white/10 hover:bg-white/20',
};
---

<a
  href={href}
  target={target}
  rel={rel}
  class={classNames(
    'inline-flex items-center gap-2 rounded-full font-semibold px-6 py-3 transition duration-300',
    variantClasses[variant],
    className
  )}
>
  <slot />
</a>
