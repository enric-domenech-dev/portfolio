---
import type { PersonalInfo } from '@/core/cv/domain/models/CVData';
import { CV_LINK, MENU_TOGGLE_LABEL, NAV_LINKS } from './constants';

interface Props {
  personal: PersonalInfo;
}

const { personal } = Astro.props;
---

<nav class="sticky top-0 z-50 px-4 py-4">
  <div class="glass-card max-w-5xl mx-auto px-5 md:px-8 py-3 md:py-4">
    <div class="flex items-center justify-between gap-4">
      <a href="#top" class="text-sm md:text-base font-semibold tracking-wide text-slate-800 dark:text-slate-100">
        {personal.name}
      </a>

      <button
        id="menuToggle"
        class="md:hidden text-slate-700 dark:text-slate-100 text-2xl leading-none"
        aria-expanded="false"
        aria-controls="mobileMenu"
        aria-label={MENU_TOGGLE_LABEL}
      >
        ☰
      </button>

      <div class="hidden md:flex items-center gap-6 text-sm font-medium">
        {NAV_LINKS.map((link) => (
          <a href={link.href} class="animated-underline text-slate-700 hover:text-primary-600 dark:text-slate-200">{link.label}</a>
        ))}
        <a href={CV_LINK.href} class="px-4 py-2 rounded-full bg-primary-500 text-white shadow-glow hover:bg-primary-600 transition duration-300">{CV_LINK.label}</a>
      </div>
    </div>

    <div id="mobileMenu" class="hidden mt-4 pt-4 border-t border-white/40 md:hidden">
      <div class="flex flex-col gap-4 text-sm font-medium">
        {NAV_LINKS.map((link) => (
          <a href={link.href} class="text-slate-700 hover:text-primary-600 dark:text-slate-200">{link.label}</a>
        ))}
        <a href={CV_LINK.href} class="w-fit px-4 py-2 rounded-full bg-primary-500 text-white shadow-glow">Ver {CV_LINK.label}</a>
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menuToggle');
  const menu = document.getElementById('mobileMenu');

  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
  });
</script>
