---
import type { Experience } from '@/core/experience/domain/models/Experience';
import { EXPERIENCE_SECTION } from '@/core/experience/constants';
import { STAGGER_STEP_MS } from '@/core/shared/constants/animations';
import { staggerDelay } from '@/core/shared/utils/formatters';
import Badge from '../shared/Badge.astro';
import Card from '../shared/Card.astro';
import Icon from '../shared/Icon.astro';

interface Props {
  items: Experience[];
}

const { items } = Astro.props;
---

<section class="py-12 px-4">
  <div class="max-w-5xl mx-auto">
    <h2 class="section-title">{EXPERIENCE_SECTION.title}</h2>

    <div class="relative pl-5 md:pl-8 space-y-6 before:absolute before:left-1 before:top-2 before:bottom-2 before:w-0.5 before:bg-gradient-to-b before:from-primary-500 before:to-secondary-400">
      {items.map((exp, index) => (
        <Card variant="glass" hover class="relative p-6 md:p-7 animate-fade-up" style={staggerDelay(index, STAGGER_STEP_MS.cards)}>
          <span class="absolute -left-6 md:-left-9 top-9 h-4 w-4 rounded-full bg-primary-500 ring-4 ring-primary-200/60"></span>
          <div class="flex flex-wrap justify-between items-start gap-3 mb-3">
            <div>
              <p class="flex items-center gap-1.5 text-xs uppercase tracking-[0.2em] text-primary-500 mb-2">
                <Icon name="briefcase" size={14} />
                {EXPERIENCE_SECTION.eyebrow}
              </p>
              <h3 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-slate-100">{exp.position}</h3>
              <p class="text-base md:text-lg text-slate-600 dark:text-slate-300">{exp.company}</p>
            </div>
            <Badge variant="neo">{exp.duration}</Badge>
          </div>
          <p class="text-slate-700 dark:text-slate-200 leading-relaxed">{exp.description}</p>
        </Card>
      ))}
    </div>
  </div>
</section>
