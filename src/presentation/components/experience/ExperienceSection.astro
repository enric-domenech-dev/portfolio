---
import type { Experience } from '@/core/experience/domain/models/Experience';
import type { Project } from '@/core/projects/domain/models/Project';
import { getExperienceSection } from '@/core/experience/constants';
import { getProjectsSection } from '@/core/projects/constants';
import { getCompanyLogo } from '@/core/shared/constants/companyLogos';
import { resolveLocale } from '@/core/shared/i18n/locale';
import Badge from '../shared/Badge.astro';
import Card from '../shared/Card.astro';
import Icon from '../shared/Icon.astro';

interface Props {
  items: Experience[];
  projects: Project[];
}

const { items, projects } = Astro.props;
const experienceSection = getExperienceSection(resolveLocale(Astro.currentLocale));
const projectsSection = getProjectsSection(resolveLocale(Astro.currentLocale));

const normalize = (value: string) => value.trim().toUpperCase();

const groups = items.map((exp) => ({
  experience: exp,
  logo: getCompanyLogo(exp.company),
  projects: projects.filter((project) => project.company && normalize(project.company) === normalize(exp.company)),
}));
---

<section class="py-12 px-4">
  <div class="max-w-5xl mx-auto">
    <h2 class="section-title">{experienceSection.title}</h2>

    <div id="career-timeline" class="relative pl-6 md:pl-10">
      <div class="timeline-track absolute left-[3px] top-1 bottom-1 w-[3px] rounded-full bg-slate-900/10 dark:bg-white/10"></div>
      <div class="timeline-progress absolute left-[3px] top-1 w-[3px] rounded-full bg-gradient-to-b from-primary-500 to-secondary-400"></div>

      <div class="space-y-10">
        {groups.map(({ experience: exp, logo, projects: relatedProjects }) => (
          <div>
            <Card data-timeline-item variant="glass" hover class="relative overflow-hidden p-6 md:p-7">
              <span class="timeline-dot absolute -left-[29px] md:-left-[45px] top-9 h-3.5 w-3.5 rounded-full bg-slate-400 dark:bg-slate-600 ring-4 ring-[var(--bg)] transition-colors duration-500"></span>
              <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-primary-500 to-secondary-400"></div>

              <div class="flex items-center gap-4">
                {logo && (
                  <div class="flex h-14 w-14 md:h-16 md:w-16 shrink-0 items-center justify-center rounded-2xl bg-white p-2 border border-slate-900/5">
                    <img src={logo} alt={`Logo ${exp.company}`} class="max-h-full max-w-full object-contain" loading="lazy" />
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap justify-between items-start gap-3">
                    <div>
                      <p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-primary-500 mb-1.5">
                        <Icon name="briefcase" size={13} />
                        {experienceSection.eyebrow}
                      </p>
                      <h3 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-slate-100 leading-tight">{exp.position}</h3>
                      <p class="text-base text-slate-600 dark:text-slate-300">{exp.company}</p>
                    </div>
                    <Badge variant="neo">{exp.duration}</Badge>
                  </div>
                </div>
              </div>
              <p class="mt-4 text-slate-700 dark:text-slate-200 leading-relaxed">{exp.description}</p>
            </Card>

            {relatedProjects.length > 0 && (
              <div class="relative mt-4 ml-7 md:ml-[4.5rem] space-y-4 pl-5 md:pl-7">
                <div class="absolute left-0 top-1 bottom-1 w-px bg-secondary-400/30 dark:bg-secondary-400/25"></div>
                {relatedProjects.map((project) => (
                  <Card data-timeline-item variant="glass" hover class="relative overflow-hidden p-5">
                    <div class="absolute inset-y-0 left-0 w-1 bg-secondary-400"></div>
                    <p class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-secondary-600 dark:text-secondary-300 mb-2">
                      <Icon name="code" size={13} />
                      {projectsSection.eyebrow}
                    </p>
                    <h4 class="text-base font-bold text-slate-900 dark:text-slate-100 mb-1.5">{project.title}</h4>
                    <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed mb-3">{project.description}</p>
                    <div class="flex flex-wrap gap-2 mb-3">
                      {project.stack.map((tech) => (
                        <span class="rounded-full border border-secondary-300/60 dark:border-secondary-400/30 text-secondary-700 dark:text-secondary-200 text-xs font-medium px-3 py-1">
                          {tech}
                        </span>
                      ))}
                    </div>
                    {(project.repoUrl || project.demoUrl) && (
                      <div class="flex flex-wrap gap-4 text-sm font-medium">
                        {project.repoUrl && (
                          <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-primary-600 hover:text-primary-700">
                            <Icon name="github" size={14} /> {projectsSection.repo}
                          </a>
                        )}
                        {project.demoUrl && (
                          <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-primary-600 hover:text-primary-700">
                            <Icon name="external-link" size={14} /> {projectsSection.demo}
                          </a>
                        )}
                      </div>
                    )}
                  </Card>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .timeline-progress {
    height: 0%;
    transition: height 150ms linear;
  }

  #career-timeline [data-timeline-item] {
    position: relative;
  }

  :global(html.js-timeline-ready) #career-timeline [data-timeline-item] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 550ms cubic-bezier(0.2, 0, 0, 1), transform 550ms cubic-bezier(0.2, 0, 0, 1);
  }

  :global(html.js-timeline-ready) #career-timeline [data-timeline-item].is-visible {
    opacity: 1;
    transform: none;
  }

  #career-timeline [data-timeline-item].is-visible .timeline-dot {
    background-color: theme('colors.primary.500');
  }
</style>

<script>
  document.documentElement.classList.add('js-timeline-ready');

  const container = document.getElementById('career-timeline');
  if (container) {
    const progressEl = container.querySelector<HTMLElement>('.timeline-progress');
    const items = container.querySelectorAll<HTMLElement>('[data-timeline-item]');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10% 0px' }
    );
    items.forEach((item) => observer.observe(item));

    let ticking = false;
    const updateProgress = () => {
      ticking = false;
      if (!progressEl) return;
      const rect = container.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const total = rect.height + viewportHeight;
      const traveled = viewportHeight - rect.top;
      const pct = Math.min(1, Math.max(0, traveled / total));
      progressEl.style.height = `${pct * 100}%`;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateProgress);
      }
    };

    updateProgress();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>
