---
import type { PersonalInfo } from '@/core/cv/domain/models/CVData';
import Button from '../shared/Button.astro';
import Icon from '../shared/Icon.astro';
import { AVATAR_SRC, getHeroLabels } from './constants';
import { localizedPath, resolveLocale } from '@/core/shared/i18n/locale';

interface Props {
  personal: PersonalInfo;
}

const { personal } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const heroLabels = getHeroLabels(locale);
---

<header class="text-white px-4 py-6 md:py-8">
  <div class="relative overflow-hidden rounded-[2rem] max-w-5xl mx-auto bg-hero-gradient bg-[length:200%_200%] animate-gradient-shift shadow-glow px-6 md:px-10 py-16 md:py-20">
    <div class="absolute inset-0 bg-slate-900/15"></div>
    <div class="relative animate-fade-up">
      <img
        src={AVATAR_SRC}
        alt={personal.name}
        width="144"
        height="144"
        class="w-28 h-28 md:w-36 md:h-36 rounded-full object-cover ring-4 ring-white/40 shadow-glow mb-6"
      />
      <p class="uppercase tracking-[0.24em] text-xs md:text-sm text-cyan-100 mb-4">{heroLabels.eyebrow}</p>
      <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-4">{personal.name}</h1>
      <p class="text-xl md:text-2xl font-medium text-indigo-100 mb-5">{personal.title}</p>
      <p class="text-slate-100/95 max-w-3xl mb-8 text-base md:text-lg">{personal.bio}</p>

      <div class="flex flex-wrap gap-4">
        <Button href={localizedPath('/experiencia', locale)} variant="solid">
          {heroLabels.exploreExperience}
          <Icon name="arrow-right" size={16} />
        </Button>
        <Button href={localizedPath('/cv', locale)} variant="outline">{heroLabels.viewFullCv}</Button>
        {personal.links.linkedin && (
          <Button href={personal.links.linkedin} variant="outline" target="_blank" rel="noopener noreferrer">
            <Icon name="linkedin" size={16} />
            {heroLabels.linkedin}
          </Button>
        )}
        {personal.links.github && (
          <Button href={personal.links.github} variant="outline" target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={16} />
            {heroLabels.github}
          </Button>
        )}
      </div>
    </div>
  </div>
</header>
