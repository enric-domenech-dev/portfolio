---
import Layout from '../layouts/Layout.astro';
import ContactSection from '../components/contact/ContactSection.astro';
import { container } from '@/core/di/container';
import { getContactSection } from '../components/contact/constants';
import { getSiteDefaults } from '@/core/shared/constants/ui';
import { resolveLocale } from '@/core/shared/i18n/locale';

const locale = resolveLocale(Astro.currentLocale);
const cvData = container.getCVData.execute(locale);
const contactSection = getContactSection(locale);
const siteDefaults = getSiteDefaults(locale);
---

<Layout title={`${contactSection.title} - ${siteDefaults.title}`}>
  <ContactSection personal={cvData.personal} />
</Layout>
