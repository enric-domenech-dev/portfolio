---
import Layout from '../layouts/Layout.astro';
import ProjectsSection from '../components/projects/ProjectsSection.astro';
import { container } from '@/core/di/container';
import { getProjectsSection } from '@/core/projects/constants';
import { getSiteDefaults } from '@/core/shared/constants/ui';
import { resolveLocale } from '@/core/shared/i18n/locale';

const locale = resolveLocale(Astro.currentLocale);
const items = container.getProjects.execute(locale);
const projectsSection = getProjectsSection(locale);
const siteDefaults = getSiteDefaults(locale);
---

<Layout title={`${projectsSection.title} - ${siteDefaults.title}`}>
  <ProjectsSection items={items} />
</Layout>
