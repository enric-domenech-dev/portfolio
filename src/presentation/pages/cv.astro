---
import Layout from '../layouts/Layout.astro';
import CVSection from '../components/cv/CVSection.astro';
import { container } from '@/core/di/container';
import { getCvLabels } from '@/core/cv/constants';
import { resolveLocale } from '@/core/shared/i18n/locale';

const locale = resolveLocale(Astro.currentLocale);
const cvData = container.getCVData.execute(locale);
const cvLabels = getCvLabels(locale);
---

<Layout title={cvLabels.pageTitle}>
  <CVSection cvData={cvData} />
</Layout>
